# Copie ce fichier en .env pour lancer l'API en local.
# En déploiement, ces variables viennent du secret GitHub ENV_FILE_CONTENTS
# de l'environnement ciblé (voir enervision-devops/envs/*.env.example) et
# sont injectées par compose/api.yml.

DATABASE_URL=postgresql+psycopg://g4_app:change_me@localhost:5432/g4_db

# Authentification JWT
JWT_SECRET_KEY=change_me_dev_only
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Compte de service utilisé pour obtenir un token (POST /auth/login).
# À remplacer par une vraie gestion utilisateurs si le sujet l'exige.
# API_PASSWORD_HASH : hash Argon2id du mot de passe, jamais le mot de passe
# en clair. Pour le générer :
#   python -c "from app.security import hash_password; print(hash_password('mon_mdp'))"
API_USERNAME=admin
API_PASSWORD_HASH=change_me_generate_with_hash_password
